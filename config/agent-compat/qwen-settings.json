{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"__PROJECT_ROOT__/scripts/agent-compat/brainstorm-evidence.mjs\" --host qwen",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"__PROJECT_ROOT__/scripts/agent-compat/qwen-session-start.mjs\"",
            "timeout": 10000,
            "statusMessage": "Loading Ferry session context"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "run_shell_command",
        "hooks": [
          {
            "type": "command",
            "command": "\"__HOME__/.claude/hooks/credential-guard.sh\"",
            "timeout": 8000
          },
          {
            "type": "command",
            "command": "\"__HOME__/.claude/hooks/branch-guard.sh\"",
            "timeout": 8000
          },
          {
            "type": "command",
            "command": "node \"__PROJECT_ROOT__/scripts/agent-compat/qwen-tool-translate.mjs\" \"__HOME__/.claude/hooks/github-plain-english-guard.sh\"",
            "timeout": 8000
          },
          {
            "type": "command",
            "command": "node \"__PROJECT_ROOT__/scripts/agent-compat/destructive-git-guard.mjs\"",
            "timeout": 5000
          },
          {
            "type": "command",
            "command": "node \"__PROJECT_ROOT__/scripts/agent-compat/qwen-tool-translate.mjs\" \"__PROJECT_ROOT__/.claude/hooks/plain-english-github.sh\"",
            "timeout": 30000
          }
        ]
      },
      {
        "matcher": "write_file|edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"__HOME__/.claude/hooks/write-guard.sh\"",
            "timeout": 8000
          },
          {
            "type": "command",
            "command": "node \"__PROJECT_ROOT__/scripts/agent-compat/qwen-tool-translate.mjs\" \"__HOME__/.claude/hooks/docs-plain-english-guard.sh\"",
            "timeout": 8000
          },
          {
            "type": "command",
            "command": "node \"__PROJECT_ROOT__/scripts/agent-compat/qwen-tool-translate.mjs\" \"__PROJECT_ROOT__/.claude/hooks/plain-english-docs.sh\"",
            "timeout": 30000
          }
        ]
      },
      {
        "matcher": "read_file",
        "hooks": [
          {
            "type": "command",
            "command": "\"__HOME__/.claude/hooks/read-guard.sh\"",
            "timeout": 8000
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"__PROJECT_ROOT__/scripts/agent-compat/brainstorm-evidence.mjs\" --host qwen",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "__QWEN_POST_TOOL_MATCHER__",
        "hooks": [
          {
            "type": "command",
            "command": "\"__HOME__/.claude/hooks/qmd-live-update.sh\"",
            "timeout": 10000
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"__PROJECT_ROOT__/scripts/agent-compat/brainstorm-evidence.mjs\" --host qwen",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"__PROJECT_ROOT__/scripts/agent-compat/brainstorm-evidence.mjs\" --host qwen",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"__PROJECT_ROOT__/scripts/agent-compat/qwen-stop-guard.mjs\"",
            "timeout": 5000
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"__PROJECT_ROOT__/scripts/agent-compat/brainstorm-evidence.mjs\" --host qwen",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "mcpServers": {
    "qmd": {
      "command": "qmd",
      "args": ["mcp"],
      "timeout": 20000
    },
    "serena": {
      "command": "serena",
      "args": ["start-mcp-server", "--context", "qwen", "--project-from-cwd"],
      "timeout": 30000
    },
    "context7": {
      "command": "node",
      "args": ["__DATA_HOME__/discord-ferry/reviewer-runtime/current/context7-mcp.mjs"],
      "timeout": 30000
    },
    "second-opinion": {
      "command": "node",
      "args": ["__PROJECT_ROOT__/scripts/agent-compat/second-opinion-mcp.mjs"],
      "timeout": 30000,
      "discoveryTimeoutMs": 120000
    }
  },
  "modelProviders": {
    "openai": [
      {
        "id": "qwen3.8-max",
        "name": "QwenCloud qwen3.8-max",
        "baseUrl": "https://token-plan.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1",
        "envKey": "BAILIAN_TOKEN_PLAN_API_KEY",
        "generationConfig": {
          "extra_body": {
            "enable_thinking": true
          },
          "thinkingMandatory": true
        }
      },
      {
        "id": "qwen3.6-flash",
        "name": "QwenCloud qwen3.6-flash",
        "baseUrl": "https://token-plan.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1",
        "envKey": "BAILIAN_TOKEN_PLAN_API_KEY"
      }
    ]
  },
  "security": {
    "auth": {
      "selectedType": "openai"
    }
  },
  "model": {
    "name": "qwen3.8-max",
    "baseUrl": "https://token-plan.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1"
  },
  "fastModel": "qwen3.6-flash",
  "agents": {
    "builtin": {
      "exploreModel": "fast"
    }
  },
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(uv *)",
      "Bash(gh *)",
      "Bash(node scripts/*)",
      "Bash(FERRY_REVIEWER_RUNTIME=\"${XDG_DATA_HOME:-$HOME/.local/share}/discord-ferry/reviewer-runtime/current\"*)",
      "Bash(node \"$FERRY_REVIEWER_RUNTIME/review-ensemble.mjs\" *)",
      "Bash(node \"$FERRY_REVIEWER_RUNTIME/review-verification.mjs\" *)",
      "Bash(plain-english *)",
      "Bash(npx --no-install plain-english *)",
      "Bash(python3 *)",
      "Bash(python *)",
      "Bash(qmd *)",
      "Bash(serena *)",
      "Bash(jq *)",
      "Bash(ls *)",
      "Bash(find *)",
      "Bash(wc *)",
      "Bash(ln *)",
      "Skill(*)",
      "Read(~/**)",
      "Read(//tmp/**)",
      "mcp__qmd",
      "mcp__context7",
      "mcp__serena",
      "mcp__second-opinion__get_default_opinion",
      "mcp__second-opinion__get_gemini_opinion",
      "mcp__second-opinion__get_mistral_opinion",
      "mcp__second-opinion__get_personality_opinion"
    ]
  }
}
