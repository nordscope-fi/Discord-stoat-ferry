{
  "description": "Discord Ferry Codex lifecycle hooks. Guard scripts live under ~/.claude/hooks/. Generated by scripts/agent-compat/install-local.mjs.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"__PROJECT_ROOT__/scripts/agent-compat/codex-hook-adapter.mjs\" session-start",
            "timeout": 10,
            "statusMessage": "Loading Ferry session context",
            "additionalContextLimit": 5000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"__PROJECT_ROOT__/scripts/agent-compat/codex-hook-adapter.mjs\" pre-tool",
            "timeout": 10,
            "statusMessage": "Checking Ferry tool policy"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "__POST_TOOL_MATCHER__",
        "hooks": [
          {
            "type": "command",
            "command": "node \"__PROJECT_ROOT__/scripts/agent-compat/codex-hook-adapter.mjs\" post-tool",
            "timeout": 10,
            "statusMessage": "Running Ferry post-tool checks",
            "additionalContextLimit": 3000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"__PROJECT_ROOT__/scripts/agent-compat/codex-hook-adapter.mjs\" stop",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
